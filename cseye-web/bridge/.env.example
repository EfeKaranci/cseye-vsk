# Copy to .env and fill in to enable cloud publishing (Phase 3).
# The bridge reads these from the environment; the service_role key never
# reaches the browser.
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=cseye
CSEYE_SHARE_URL=https://your-pages-site.pages.dev/share.html
# Optional: browsable model roots (default C:\Analysis)
CSEYE_ROOTS=C:\Analysis
